# Trading Pro Max staging environment template.
# Copy values into a local ignored env file or staging secret manager.

NODE_ENV=production
TPM_DEPLOYMENT_TARGET=staging
TPM_LAUNCH_MODE=staging

# Real staging deployment evidence. These remain blockers until a host exists.
TPM_STAGING_BASE_URL=
TPM_STAGING_DEPLOYMENT_ID=
TPM_STAGING_ROLLBACK_REF=

# Staging may use a persistent isolated DB. Do not use prisma/dev.db.
DATABASE_URL=

# Operator key and rotated credentials must still be non-default.
TPM_OPERATOR_KEY=
TPM_DEMO_EMAIL=
TPM_DEMO_PASSWORD=
TPM_OPERATOR_EMAIL=
TPM_OPERATOR_PASSWORD=

# At least one staging evaluator is required; production closed beta requires five.
TPM_CLOSED_BETA_ALLOWLIST=
TPM_CLOSED_BETA_ALLOWLIST_EMAILS=
TPM_CLOSED_BETA_ALLOWLIST_ACCOUNT_IDS=
TPM_CLOSED_BETA_MAX_EVALUATORS=5

# Monitoring may remain a warning in staging unless launch mode is production.
TPM_MONITORING_PROVIDER=
TPM_MONITORING_ENDPOINT=
TPM_MONITORING_KEY=
TPM_OPS_EXTERNAL_MONITOR_PROVIDER=
TPM_OPS_EXTERNAL_MONITOR_URL=
TPM_OPS_EXTERNAL_MONITOR_KEY=
TPM_OPS_TRACING_ENDPOINT=

TPM_TRUST_PROXY_HEADERS=false
TPM_ALLOW_AUTHORIZATION_BEARER=false
