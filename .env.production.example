# Trading Pro Max production environment template.
# Copy values into your deployment secret manager. Do not commit real .env files.

# Deployment scope. production enforces the strictest validation.
NODE_ENV=production
TPM_DEPLOYMENT_TARGET=production
TPM_LAUNCH_MODE=closed_beta

# Pre-launch rotation attestation. Keep false until every required secret has
# been rotated in deployment secret storage.
TPM_PRE_LAUNCH_SECRET_ROTATION_CONFIRMED=false
TPM_SECRET_ROTATION_BATCH_ID=
TPM_SECRET_ROTATION_COMPLETED_AT=

# Database.
# Current runtime is Prisma SQLite. Use a persistent absolute file: URL on managed
# durable storage, or migrate the Prisma datasource before using managed SQL.
DATABASE_URL=

# Operator release/review key. Generate outside the repo and store as a secret.
TPM_OPERATOR_KEY=

# Rotated beta/demo credentials. Defaults in prisma/seed.mjs are local-only.
TPM_DEMO_EMAIL=
TPM_DEMO_PASSWORD=
TPM_OPERATOR_EMAIL=
TPM_OPERATOR_PASSWORD=

# Closed beta access control. Use exactly the real evaluator identities.
TPM_CLOSED_BETA_ALLOWLIST=
TPM_CLOSED_BETA_ALLOWLIST_EMAILS=
TPM_CLOSED_BETA_ALLOWLIST_ACCOUNT_IDS=
TPM_CLOSED_BETA_MAX_EVALUATORS=5

# External monitoring readiness. Presence is checked without exposing values.
TPM_MONITORING_PROVIDER=
TPM_MONITORING_ENDPOINT=
TPM_MONITORING_KEY=
TPM_OPS_EXTERNAL_MONITOR_PROVIDER=
TPM_OPS_EXTERNAL_MONITOR_URL=
TPM_OPS_EXTERNAL_MONITOR_KEY=
TPM_OPS_TRACING_ENDPOINT=

# Broker/feed pilot credentials. Leave blank unless a real provider has issued
# rotated sandbox/live values and operator policy release remains explicit.
TPM_BROKER_PROVIDER=
TPM_BROKER_CONNECTOR_URL=
TPM_BROKER_API_KEY=
TPM_BROKER_API_SECRET=
TPM_BROKER_SANDBOX_URL=
TPM_BROKER_SANDBOX_API_KEY=
TPM_BROKER_SANDBOX_API_SECRET=
TPM_BROKER_LIVE_URL=
TPM_BROKER_LIVE_API_KEY=
TPM_BROKER_LIVE_API_SECRET=
TPM_BROKER_PILOT_POLICY_RELEASE=false
TPM_MARKET_FEED_URL=
TPM_MARKET_FEED_API_KEY=
TPM_MARKET_FEED_API_SECRET=
TPM_MARKET_FEED_SANDBOX_URL=
TPM_MARKET_FEED_SANDBOX_API_KEY=
TPM_MARKET_FEED_SANDBOX_API_SECRET=
TPM_MARKET_FEED_LIVE_URL=
TPM_MARKET_FEED_LIVE_API_KEY=
TPM_MARKET_FEED_LIVE_API_SECRET=
TPM_MARKET_FEED_ENABLE_EXTERNAL=false
TPM_PILOT_BROKER_URL=
TPM_PILOT_BROKER_API_KEY=
TPM_PILOT_BROKER_API_SECRET=
TPM_PILOT_FEED_URL=
TPM_PILOT_FEED_API_KEY=
TPM_PILOT_FEED_API_SECRET=
TPM_PILOT_ACTIVATION_REQUESTED=false
TPM_PILOT_POLICY_RELEASE=false

# Notification/delivery readiness. Provider secrets must be rotated at the
# provider before enabling delivery; no delivery is active by default.
TPM_ALERTS_DELIVERY_OPERATOR_RELEASE=false
TPM_ALERTS_EMAIL_PROVIDER=
TPM_ALERTS_PUSH_PROVIDER=
TPM_ALERTS_WEBHOOK_URL=
TPM_ALERTS_QUEUE_BACKEND_URL=
TPM_ALERTS_SCHEDULER_ENABLE=false

# Optional production proxy/session settings.
TPM_TRUST_PROXY_HEADERS=false
TPM_ALLOW_AUTHORIZATION_BEARER=false
