!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report

# next.js
/.next/
/out/
/dist/

# prisma
/lib/db/generated/
/prisma/dev.db
/prisma/dev.db-journal

# production
/build

# local runtime, caches, archives, and generated backups
/.cache/
/tmp/
/temp/
/runtime/backups/
/legacy-trading-pro-max-archives/
*.zip
*.7z
*.rar
*.tar
*.tar.gz

